# Copy to an ignored .env.agents file. Choose private values, not these placeholders.
AGENT_DASHBOARD_PASSWORD=replace-with-a-long-dashboard-password
CHANNEL_TOKEN_A=replace-with-a-random-token-at-least-32-characters
CHANNEL_TOKEN_B=replace-with-a-different-random-token-at-least-32-characters

# Set the same fixed HTTPS origin as RAZIEL_NGROK_URL in the backend settings.
# This prefills new connections. Saved connections and tokens remain private and unchanged.
RAZIEL_API_BASE_URL=https://either-anymore-immunize.ngrok-free.dev

# Server-side OpenAI-compatible settings. An LLM failure does not erase task state.
SOCLAAS_ENV_PATH=/private/path/to/soclaas.env
# For a native process only: LLM_ENV_FILE=/private/path/to/soclaas.env
# The private file can use SOCLAAS_BASE_URL, SOCLAAS_MODEL, and SOCLAAS_API_KEY.
# LLM_BASE_URL, LLM_MODEL, and LLM_API_KEY take precedence over SOCLAAS values.

# Optional public browser origins, including SSH-forwarded or HTTPS demo URLs.
AGENT_A_ORIGINS=http://127.0.0.1:3001,http://localhost:3001
AGENT_B_ORIGINS=http://127.0.0.1:3002,http://localhost:3002
